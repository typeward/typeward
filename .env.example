# Typeward env. Real values live in .env.local (gitignored). This file
# is the committed placeholder so contributors know what's expected.

# OAuth client ids — register the apps yourself (links inline). GitHub signs in
# through the device flow, so its id needs no accompanying secret. Mendeley is a
# confidential client: it also needs a client secret, which is NOT an env var —
# enter it in Settings, where it goes to the OS keyring.
VITE_MENDELEY_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# Sentry source-map upload token goes in .env.sentry-build-plugin (gitignored,
# NOT this file — it's a secret). Create an org auth token at
# https://typeward.sentry.io/settings/auth-tokens/ and put this line there:
#   SENTRY_AUTH_TOKEN=sntrys_...
# Without it, builds skip sourcemap generation + upload entirely.
