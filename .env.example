# Typeward env. Real values live in .env.local (gitignored). This file
# is the committed placeholder so contributors know what's expected.

# OAuth client ids — register the app yourself (link inline). Mendeley is a
# confidential client: it also needs a client secret, which is NOT an env var —
# enter it in Settings, where it goes to the OS keyring.
VITE_MENDELEY_CLIENT_ID=
