# Typeward env. Real values live in .env.local (gitignored). This file
# is the committed placeholder so contributors know what's expected.

# Supabase (Integ Phase 7 — auth + subscription-driven entitlements).
# Project URL and publishable key from app.supabase.com → API Settings.
# Both are safe to ship in the client bundle; RLS is what protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OAuth client ids — register the apps yourself (links inline). All are
# public client identifiers — PKCE flows don't need client secrets.
VITE_MENDELEY_CLIENT_ID=
VITE_DROPBOX_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
