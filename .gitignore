# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Env
.env
.env.local
.env.*.local
.env.sentry-build-plugin

# Typeward project sidecar (per-project; only ignored if it appears in dev workspace)
# .typeward/

# Test coverage
coverage/

# Benchmark corpus + results (regenerate with bench/generate.mjs; the
# generator is committed, its multi-hundred-MB output never is)
bench/corpus/
bench/results/
bench/third-party/

# TypeScript incremental build cache (regenerated by tsc; never source)
tsconfig.tsbuildinfo
*.tsbuildinfo

# Working notes, living UI/UX specs, and design prototypes. Kept on disk as
# the local source of truth for visuals and phase history, but out of the
# public repo.
docs/
design/
design_files/

# Claude Code machine-local settings (the shared .claude/settings.json is kept)
.claude/settings.local.json

# Tauri sidecar binaries (fetched per-host via npm run fetch:tectonic).
# Keep .gitkeep so the directory exists for `externalBin` resolution.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# texlive-wasm assets (fetched per-host / per-CI, never checked in). Engines are
# served from the app origin (public/ is copied verbatim into dist/); the TeX
# Live tree ships as a Tauri resource on MOBILE ONLY (the glob lives in
# tauri.{android,ios}.conf.json, not the base config — a desktop build must
# never bundle a TeX tree the mobile-gated provider can't reach). Keep
# placeholder.txt so that `bundle.resources` glob always matches.
public/texlive-wasm/
src-tauri/resources/texlive-wasm/*
!src-tauri/resources/texlive-wasm/placeholder.txt
