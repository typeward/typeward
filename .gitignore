# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Env
.env
.env.local
.env.*.local

# Typeward project sidecar (per-project; only ignored if it appears in dev workspace)
# .typeward/

# Test coverage
coverage/

# Benchmark corpus + results (regenerate with bench/generate.mjs; the
# generator is committed, its multi-hundred-MB output never is)
bench/corpus/
bench/results/
bench/third-party/

# TypeScript incremental build cache (regenerated by tsc; never source)
tsconfig.tsbuildinfo
*.tsbuildinfo

# Working notes and living UI/UX specs. Kept on disk as the local source of
# truth for visuals and phase history, but out of the public repo.
docs/
design/

# Third-party visual reference shots and generated image explorations. The rest
# of design_files/ is the committed source of truth for visuals; these are only
# inspiration, weigh 17 MB, and carry no clear license, so they stay local.
design_files/design_samples/

# Internal build plan: dated narrative that leans on the gitignored design
# trees above, so a fresh clone could not follow its references anyway. Kept on
# the maintainer's disk; the shipped code plus CLAUDE.md are the public source
# of truth.
plan.md

# Agent tooling. `.claude/*` rather than `.claude/`, so the shared subagents in
# .claude/agents/ can be re-included: git never descends into an excluded
# directory, which makes a negation inside one silently do nothing. Everything
# else under .claude/ is machine-local (skills are maintainer-only,
# settings.local.json and the task lock are per-machine state).
.claude/*
!.claude/agents/
.serena/

# Personal per-project instructions, never repo content.
CLAUDE.local.md

# Tauri sidecar binaries (fetched per-host via npm run fetch:tectonic).
# Keep .gitkeep so the directory exists for `externalBin` resolution.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# texlive-wasm assets (fetched per-host / per-CI, never checked in). Engines are
# served from the app origin (public/ is copied verbatim into dist/); the TeX
# Live tree ships as a Tauri resource on MOBILE ONLY (the glob lives in
# tauri.{android,ios}.conf.json, not the base config — a desktop build must
# never bundle a TeX tree the mobile-gated provider can't reach). Keep
# placeholder.txt so that `bundle.resources` glob always matches.
public/texlive-wasm/
src-tauri/resources/texlive-wasm/*
!src-tauri/resources/texlive-wasm/placeholder.txt

# Local auto-updater test harness output (scripts/updater-local-test.mjs):
# signed placeholder payloads, real installers built for the loopback feed, the
# generated latest.json, and the dev endpoint overlay. All machine-local.
.updater-local-test/
