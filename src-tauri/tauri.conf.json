{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typeward",
  "version": "0.0.1",
  "identifier": "com.typeward.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Typeward",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#F8F4EA"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/Typeward/**", "$APPDATA/profile/**"]
      },
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; form-action 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' file: asset: http://asset.localhost data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; form-action 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' file: asset: http://asset.localhost data: blob: https:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage", "rpm"],
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "ext": ["tex"],
        "name": "LaTeX Source",
        "description": "LaTeX source file",
        "role": "Editor",
        "mimeType": "text/x-tex"
      },
      {
        "ext": ["typ"],
        "name": "Typst Source",
        "description": "Typst source file",
        "role": "Editor",
        "mimeType": "text/x-typst"
      },
      {
        "ext": ["bib"],
        "name": "BibTeX Bibliography",
        "description": "BibTeX bibliography file",
        "role": "Editor",
        "mimeType": "text/x-bibtex"
      }
    ],
    "externalBin": ["binaries/tectonic"],
    "resources": ["resources/templates/**/*"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libdbus-1-3"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/typeward/releases/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
